#!/usr/bin/env bash
#
# Runs everything .github/workflows/ci.yml runs, in one go, locally.
#
# The point is ordering: CI's four jobs run in parallel, so a formatting slip and
# a five-minute build cost the same wall-clock there. Locally they do not, so the
# cheap gates run first and a failure stops before the build is spent.
#
#   1. clang-format   seconds   ./bin/clang-format-fix, then the tree must be clean
#   2. cppcheck       ~25s      pio check, exactly as CI invokes it
#   3. cppcheck+       1-2m     bin/cppcheck-all over the files this branch changed
#   4. unit tests     seconds   ctest, or a g++ fallback when cmake is absent
#   5. build          minutes   pio run -e default -e sticky, ONE invocation
#
# Stage 3 has no counterpart in CI and is the reason this script exists at all:
# `pio check` derives its file list from the build environment and has been seen
# analysing 9 of 106 sources locally, so it can pass on a tree CI then rejects.
# Sweeping the changed files closes that gap without dragging in findings older
# than the branch.
#
# Only the `default` env is built. It is the ESP32-C3 firmware and carries both X3
# and X4 (-DFREEINK_DEVICE_X3 and -X4 in [base]; the device is detected at run
# time), so it is what a real X3 runs. `sticky` is an ESP32-S3 board - a different
# chip, its own toolchain, minutes more build - and nothing here is board-specific,
# so --all-envs is opt-in. CI still builds it, so a sticky-only break surfaces
# there rather than here.
#
# When both are built it is in ONE pio invocation, as CI does: a second `pio run`
# can wipe .pio/build once the S3 toolchain installs into the restored cache,
# taking the default firmware.bin with it - see the note in ci.yml.
#
# Usage:
#   bin/ci-local                 everything, building the default env
#   bin/ci-local --all-envs      also build sticky (ESP32-S3), as CI does
#   bin/ci-local --no-build      checks and tests only
#   bin/ci-local --only-checks   stages 1-3
#   bin/ci-local --base <ref>    compare against <ref> for stage 3 (default origin/master)

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

PIO="${PIO:-$HOME/.platformio/penv/bin/pio}"
BASE="origin/master"
DO_STICKY=0 DO_BUILD=1 DO_TESTS=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all-envs)    DO_STICKY=1 ;;
    --no-build)    DO_BUILD=0 ;;
    --only-checks) DO_BUILD=0; DO_TESTS=0 ;;
    --base)        BASE="$2"; shift ;;
    -h|--help)     sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)             echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

FAILED=()
stage() { printf '\n\033[1m== %s ==\033[0m\n' "$1"; }
ok()    { printf '   \033[32mok\033[0m  %s\n' "$1"; }
bad()   { printf '   \033[31mFAIL\033[0m %s\n' "$1"; FAILED+=("$1"); }

# --- 1. formatting --------------------------------------------------------
stage "clang-format"
# CI checks `git diff --exit-code` after formatting, which works there because it
# runs on a committed tree. Locally the tree is usually dirty with work in
# progress, so a bare diff cannot tell "clang-format rewrote something" from "you
# have unsaved edits". Snapshot before and after instead, and report only what
# formatting itself changed.
BEFORE="$(git diff | git hash-object --stdin)"
if ./bin/clang-format-fix; then
  AFTER="$(git diff | git hash-object --stdin)"
  if [[ "$BEFORE" == "$AFTER" ]]; then
    ok "nothing to reformat"
  else
    bad "clang-format rewrote files - commit them or CI will reject the push"
    git --no-pager diff --stat | tail -20
  fi
else
  bad "clang-format-fix errored"
fi

# --- 2. cppcheck, as CI runs it -------------------------------------------
stage "cppcheck (pio check)"
if "$PIO" check --fail-on-defect low --fail-on-defect medium --fail-on-defect high 2>&1 | tail -20; then
  ok "no defects"
else
  bad "pio check reported defects"
fi

# --- 3. cppcheck over what this branch changed ----------------------------
stage "cppcheck (lines this branch changed, vs $BASE)"
if git rev-parse --verify --quiet "$BASE" >/dev/null; then
  # Filtered to changed LINES, not changed files. Filtering by file reported
  # findings that predate the branch in any file it happened to touch, which is
  # noise nobody acts on - it flagged a useStlAlgorithm in SettingsList.h that has
  # been there far longer than this work.
  DIFF="$(mktemp)"
  { git diff -U0 "$BASE"...HEAD; git diff -U0; git diff -U0 --cached; } > "$DIFF"
  FINDINGS="$(mktemp)"
  ./bin/cppcheck-all 2>/dev/null > "$FINDINGS"
  RESULT="$(python3 - "$DIFF" "$FINDINGS" <<'PY_FILTER'
import re, sys, collections
diff_path, findings_path = sys.argv[1], sys.argv[2]
touched = collections.defaultdict(set)
current = None
for line in open(diff_path, encoding="utf-8", errors="replace"):
    if line.startswith("+++ b/"):
        current = line[6:].strip()
    elif line.startswith("@@") and current:
        m = re.search(r"\+(\d+)(?:,(\d+))?", line)
        if m:
            start = int(m.group(1))
            count = 1 if m.group(2) is None else int(m.group(2))
            touched[current].update(range(start, start + count))
out = []
for line in open(findings_path, encoding="utf-8", errors="replace"):
    m = re.match(r"([^:]+):(\d+):", line)
    if not m:
        continue
    path, lineno = m.group(1), int(m.group(2))
    if lineno in touched.get(path, ()):
        out.append(line.rstrip())
print("\n".join(out))
PY_FILTER
)"
  if [[ -z "$RESULT" ]]; then
    ok "no findings on changed lines"
  else
    bad "findings on lines this branch changed"
    printf '%s\n' "$RESULT"
  fi
  rm -f "$DIFF" "$FINDINGS"
else
  printf '   skipped: %s not found\n' "$BASE"
fi

# --- 4. unit tests --------------------------------------------------------
if [[ $DO_TESTS -eq 1 ]]; then
  stage "unit tests"
  CMAKE="$(command -v cmake || echo "$HOME/.platformio/penv/bin/cmake")"
  CTEST="$(command -v ctest || echo "$HOME/.platformio/penv/bin/ctest")"
  if [[ -x "$CMAKE" && -x "$CTEST" ]]; then
    # No -G: CI forces Ninja on a clean checkout, but locally build/test may
    # already be configured with another generator and cmake refuses to switch.
    # Reuse whatever is there, and wipe the cache only if configuring fails.
    if ! "$CMAKE" -S test -B build/test -DCMAKE_BUILD_TYPE=Release >/dev/null 2>&1; then
      rm -rf build/test/CMakeCache.txt build/test/CMakeFiles
      "$CMAKE" -S test -B build/test -DCMAKE_BUILD_TYPE=Release >/dev/null 2>&1
    fi
    if "$CMAKE" --build build/test -j"$(nproc)" >/dev/null 2>&1 &&
       OUT="$("$CTEST" --test-dir build/test --output-on-failure -j"$(nproc)" 2>&1)"; then
      # ctest phrases it "100% tests passed, 0 tests failed out of 168".
      ok "$(printf '%s' "$OUT" | grep -oE '[0-9]+% tests passed[^,]*, [0-9]+ tests failed out of [0-9]+' | head -1)"
    else
      bad "unit tests failed"
      printf '%s\n' "${OUT:-}" | grep -iE "fail|error" | head -15 | sed 's/^/   /'
    fi
  else
    # cmake is not installed here; CI installs it from pip. Compile each suite
    # directly instead, which needs the gtest that a previous configure fetched.
    GT=build/test/_deps/googletest-src/googletest/include
    GTLIB=build/test/lib
    if [[ -d "$GT" && -d "$GTLIB" ]]; then
      PASS=0 FAIL=0
      for dir in test/*/; do
        [[ -f "$dir/CMakeLists.txt" ]] || continue
        mapfile -t SRC < <(grep -oE '\$\{REPO_ROOT\}/[^ )]+\.(cpp|c)|^ +[A-Za-z0-9_]+\.(cpp|c)' "$dir/CMakeLists.txt" \
                             | sed "s|\${REPO_ROOT}/||; s|^ *||")
        FILES=(); for f in "${SRC[@]}"; do [[ -f "$f" ]] && FILES+=("$f") || FILES+=("$dir$f"); done
        mapfile -t INC < <(grep -oE '\$\{REPO_ROOT\}/[a-zA-Z0-9_/]+' "$dir/CMakeLists.txt" \
                             | sed "s|\${REPO_ROOT}/||" | sort -u)
        IFLAGS=(-I. -Ilib -Itest); for i in "${INC[@]}"; do [[ -d "$i" ]] && IFLAGS+=("-I$i"); done
        BIN="$(mktemp -u /tmp/citest-XXXX)"
        if g++ -std=gnu++2a -O0 "${IFLAGS[@]}" -I"$GT" "${FILES[@]}" \
             "$GTLIB/libgtest.a" "$GTLIB/libgtest_main.a" -lpthread -o "$BIN" 2>/dev/null \
           && "$BIN" >/dev/null 2>&1; then
          PASS=$((PASS+1))
        else
          FAIL=$((FAIL+1)); printf '   failed: %s\n' "$dir"
        fi
        rm -f "$BIN"
      done
      if [[ $FAIL -eq 0 ]]; then ok "$PASS suite(s) passed (g++ fallback, no cmake)"
      else bad "$FAIL of $((PASS+FAIL)) suites failed"; fi
      printf '   note: install cmake+ninja for the ctest path CI uses:\n'
      printf '         pip install cmake==3.31.4 ninja==1.11.1.3\n'
    else
      printf '   skipped: no cmake, and no fetched gtest in build/test\n'
    fi
  fi
fi

# --- 5. build -------------------------------------------------------------
if [[ $DO_BUILD -eq 1 ]]; then
  ENVS=(-e default); [[ $DO_STICKY -eq 1 ]] && ENVS+=(-e sticky)
  stage "build (${ENVS[*]})"
  LOG="$(mktemp)"
  if "$PIO" run "${ENVS[@]}" > "$LOG" 2>&1; then
    grep -E "^(RAM|Flash):" "$LOG" | sed 's/^/   /'
    for env in default sticky; do
      BIN=".pio/build/$env/firmware.bin"
      [[ -f "$BIN" ]] && printf '   %s  %s\n' "$(du -h "$BIN" | cut -f1)" "$BIN"
    done
    ok "built"
  else
    bad "build failed"
    grep -iE "error" "$LOG" | head -20 | sed 's/^/   /'
  fi
  rm -f "$LOG"
fi

# --- summary --------------------------------------------------------------
printf '\n'
if [[ ${#FAILED[@]} -eq 0 ]]; then
  printf '\033[32mall stages passed\033[0m — this is what CI should see\n'
  exit 0
fi
printf '\033[31m%d stage(s) failed:\033[0m\n' "${#FAILED[@]}"
printf '  - %s\n' "${FAILED[@]}"
exit 1
